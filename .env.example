# ══════════════════════════════════════════════════════════════════════════
#  SentinelVision AI — environment configuration
#  Copy to `.env` and edit. Every value below has a safe default in
#  backend/config.py, so `.env` may contain only what you want to override.
# ══════════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────────
APP_ENV=development                 # development | production
APP_HOST=0.0.0.0
APP_PORT=8008          # 8000 is often taken; change freely. Hosting
                       # platforms inject PORT instead; PORT wins when both set.
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                      # true -> one JSON object per log line

# ── Runtime storage (production) ──────────────────────────────────────────
# One directory for everything the server writes: uploads/, processed/,
# evidence/ and db/surveillance.db. Set it to the persistent-disk mount on a
# hosted deployment (Render: /var/data). Unset locally, so the per-path
# variables below (UPLOAD_DIR, PROCESSED_DIR, EVIDENCE_DIR, DATABASE_URL) are
# used as-is; when DATA_ROOT is set they become overrides.
#DATA_ROOT=/var/data

# ── Database ──────────────────────────────────────────────────────────────
# SQLite for development. PostgreSQL works unchanged, e.g.
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/sentinel
DATABASE_URL=sqlite:///./data/surveillance.db

# ── Inference ─────────────────────────────────────────────────────────────
INFERENCE_BACKEND=auto              # auto | max | onnx | ultralytics | mock
MODEL_PATH=./models/yolov8n.onnx    # primary person/object detector
MODEL_LABELS_PATH=./models/coco.names
PPE_MODEL_PATH=./models/ppe.onnx    # trained PPE detector (see --ppe below)
PPE_MODEL_LABELS_PATH=./models/ppe.names

CONFIDENCE_THRESHOLD=0.35
NMS_IOU_THRESHOLD=0.45
INFERENCE_WIDTH=640                 # network input size (square letterbox)
INFERENCE_HEIGHT=640
INFERENCE_THREADS=4
ONNX_CPU_MEM_ARENA=true             # false on memory-capped hosts (Render Free): ~120 MB less RSS,
                                    # a few % slower per run
MAX_CONCURRENT_JOBS=2               # simultaneous upload analyses; 1 on 512 MB hosts (each holds ~170 MB)
JOB_MAX_RSS_MB=0                    # fail a job cleanly above this process RSS; 0 = off,
                                    # 470 on a 512 MB host (Linux only: reads /proc/self/statm)
JOB_MAX_SECONDS=7200                # wall-clock limit per job; 0 = off

# ── PPE ───────────────────────────────────────────────────────────────────
# Get the model with:  python scripts/fetch_models.py --ppe
# Verify what is running with:  make diagnostics
# Three bars, because presence and absence are not equally easy to see and the
# model scores them accordingly. Measured over the reference footage:
#   vest      median 0.77, lower quartile 0.43   (orange hi-vis scores 0.37
#                                                 where yellow-green scores 0.84)
#   helmet    median 0.56, lower quartile 0.32
#   no-helmet median 0.34, and never once above 0.54
# One shared 0.50 bar therefore threw away about a third of genuine PPE and
# discarded 97% of the no-helmet class, which switched that class off entirely.
PPE_CONFIDENCE_THRESHOLD=0.35   # helmet / vest — an item asserted to be present
PPE_ABSENCE_CONFIDENCE_THRESHOLD=0.25   # no-helmet / no-vest. Safe at this bar
                                # because PPE_MIN_CONSECUTIVE_FRAMES, not the
                                # score, is what stops a weak reading firing
PPE_INTAKE_CONFIDENCE_THRESHOLD=0.20    # floor the model decodes at; must stay
                                # below both bars above, or absence detections
                                # are filtered out before anything can judge them
REQUIRED_PPE=helmet,vest        # helmet, vest, gloves, boots, goggles, mask,
                                # harness — an item with no model class stays
                                # undetermined and cannot raise a violation

# Map a third-party model's class names onto those items when its naming is
# not one the built-in synonym table recognises. Format: label=item:present|
# absent, or label=person. Leave empty for models named conventionally.
#   PPE_CLASS_MAP=Hard_hat=helmet:present,No-Helmet=helmet:absent,Worker=person
PPE_CLASS_MAP=

# Fraction of a PPE box that must fall inside a person box before the item is
# credited to that person. Together with the per-item body band this is what
# stops a helmet on a bench from clearing the person standing next to it.
PPE_ASSOCIATION_THRESHOLD=0.55
PPE_MIN_PERSON_HEIGHT=96        # below this a person box has too few pixels
PPE_MIN_CONSECUTIVE_FRAMES=5    # frames a finding must hold before it fires

# ── Hard-hat validation ───────────────────────────────────────────────────
# A PPE model finds head *coverings*: it calls a baseball cap a helmet, and it
# is confident when it does — 27 of 28 caps on the reference footage. Only an
# industrial hard hat is valid PPE, so every helmet detection is re-checked by
# a model that can actually tell the two apart. Measured on 45 real head crops:
# 0% of caps accepted, 75% of hard hats recognised, against the PPE detector's
# 96% cap-false-positive rate. Install it with:
#     python scripts/fetch_models.py --hardhat
HARDHAT_VALIDATION_ENABLED=true # false trusts the detector — caps included
HARDHAT_MODEL_PATH=./models/hardhat_validator.onnx
HARDHAT_PROMPTS_PATH=./models/hardhat_prompts.npz
HARDHAT_CONFIDENCE_THRESHOLD=0.50   # p(industrial hard hat) needed to accept a
                                    # helmet; measured — 0.70 costs 44 points
                                    # of recall for no gain in precision
HARDHAT_ALLOW_HEURISTIC=false   # true permits the structural fallback when no
                                # validator model is installed
HARDHAT_VALIDATE_EVERY_N_DETECTIONS=6   # ~55ms per head; headwear does not
                                        # change frame to frame
HARDHAT_SMOOTHING_WINDOW=3      # validations averaged before the verdict reads

# The HSV colour heuristic is the fallback for when no PPE model is installed.
# It is a real measurement but materially less reliable than a trained model:
# results are capped at 0.62 confidence and flagged method="heuristic"
# everywhere they surface, and the dashboard labels them HEURISTIC FALLBACK.
# Leave this false in production — with a model installed it never engages, and
# without one it is better to report PPE as undetermined than to guess.
PPE_ALLOW_HEURISTIC=false
PPE_EVERY_N_DETECTIONS=1   # raise to trade PPE latency for throughput

# ── Mojo acceleration (optional) ──────────────────────────────────────────
# When the Mojo toolchain is unavailable the numpy fallback is used and
# `GET /api/diagnostics` reports mojo.active=false.
MOJO_ENABLED=auto                   # auto | on | off
MOJO_LIB_PATH=./backend/inference/mojo/build/libsv_kernels.dylib

# ── Video pipeline ────────────────────────────────────────────────────────
TARGET_FPS=12                       # pipeline throttle (0 = unlimited)
DETECT_EVERY_N_FRAMES=2             # run the detector every Nth frame;
                                    # intermediate frames use the tracker
MAX_STREAM_WIDTH=960                # decode-side downscale cap
STREAM_OPEN_TIMEOUT_SECONDS=6    # give up on an unreachable stream this fast
RECONNECT_BACKOFF_SECONDS=3
RECONNECT_MAX_BACKOFF_SECONDS=60
FRAME_QUEUE_SIZE=2                  # small = drop stale frames, stay live
AUTO_START_CAMERAS=false            # true starts every enabled camera at boot;
                                    # false leaves them to the cameras API

# ── Tracking (ByteTrack) ──────────────────────────────────────────────────
TRACK_HIGH_THRESHOLD=0.5
TRACK_LOW_THRESHOLD=0.1
TRACK_MATCH_IOU=0.8
TRACK_MAX_AGE_FRAMES=30
TRACK_MIN_HITS=3

# ── Behaviour analysis thresholds ─────────────────────────────────────────
LOITERING_THRESHOLD=60              # seconds inside a zone before alerting
RUNNING_THRESHOLD=2.2               # body-heights per second
FALL_ASPECT_RATIO=1.35              # w/h above which a box reads horizontal
FALL_VERTICAL_DROP=0.28             # fraction of box height dropped, fast
FALL_CONFIRM_SECONDS=1.0            # horizontal must persist this long
CROWD_THRESHOLD=15                  # people in a zone -> crowd anomaly
CROWD_BASELINE_WINDOW=120           # seconds of history for the baseline

# ── Annotated video output ────────────────────────────────────────────────
# The full annotated render is the primary result of analysing an upload:
# every frame of the source, in order, with detections and events drawn on it.
PROCESSED_DIR=./processed           # renders live here, not under evidence/
ANNOTATED_VIDEO_ENABLED=true
EVENT_OVERLAY_SECONDS=2.5           # how long an event banner stays on screen;
                                    # one frame at 25fps is 40ms — invisible
ANNOTATED_MAX_WIDTH=1920            # working width: frames wider than this are scaled
                                    # down right after decode (detection, annotation
                                    # and the render all use the smaller frame)
ANNOTATED_FFMPEG_FINALISE=true      # +faststart (makes seeking instant), audio
                                    # mux, and transcode if the codec would not
                                    # play in a browser. Needs ffmpeg on PATH.
ANNOTATED_CRF=23                    # only used when a transcode is needed
ANNOTATED_FFMPEG_THREADS=0          # 0 = one per core; 1 on 512 MB hosts (libx264 memory scales with threads)

# ── Overlay rendering ─────────────────────────────────────────────────────
# What the render draws. The default is PPE-first: tight boxes on the head and
# torso where the finding actually is, and no body-sized rectangle over the
# top of them. Person detection and tracking are untouched by these — they
# still drive PPE association, zones, loitering and every event; this only
# decides what reaches the screen.
SHOW_PPE_BOXES=true                 # helmet on the head, vest on the torso
SHOW_PERSON_BOXES=false             # the whole-person rectangle; on for
                                    # debugging tracking, or for a site whose
                                    # events are mostly zone/movement-based
SHOW_TRACK_ID=false                 # adds a small "ID #010" under each label

# ── Events / alerts ───────────────────────────────────────────────────────
EVENT_COOLDOWN_SECONDS=30           # per (camera, type, person) debounce
EVENT_MAX_PER_MINUTE=12             # burst cap per (camera, type, zone); 0 = off
                                    # catches the case where person IDs churn
                                    # and the per-person debounce cannot bite
EVENT_MIN_CONFIDENCE=0.4
EVIDENCE_DIR=./evidence
CLIP_BUFFER_SECONDS=8               # rolling pre-event buffer
CLIP_POST_SECONDS=4
CLIP_ENABLED=true
SNAPSHOT_JPEG_QUALITY=85

# ── Uploads ───────────────────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=512
ALLOWED_VIDEO_EXTENSIONS=.mp4,.avi,.mov,.mkv,.webm

# ── Security ──────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional shared-secret API key. Leave empty to disable auth entirely
# (fine for a LAN dev box; set it for anything reachable from outside).
API_KEY=
