# Frontend build-time configuration (Vite reads VITE_* at `npm run build`).
# Copy to .env.local for local overrides; .env* files other than this one are
# git-ignored.

# Backend origin when the API is hosted separately (Render Static Site +
# Web Service). Leave empty for same-origin / the dev-server proxy.
VITE_API_URL=

# Optional: explicit WebSocket origin. Derived from VITE_API_URL when unset.
VITE_WS_URL=

# Only when the backend sets API_KEY.
VITE_API_KEY=

# Dev only: where `npm run dev` proxies /api and /ws.
VITE_API_TARGET=http://127.0.0.1:8008
